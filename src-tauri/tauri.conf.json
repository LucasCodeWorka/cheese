{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Cheese",
  "version": "0.1.0",
  "identifier": "com.cheese.desktop",
  "build": { "beforeDevCommand": "npm run dev", "devUrl": "http://localhost:1420", "beforeBuildCommand": "npm run build", "frontendDist": "../dist" },
  "app": { "windows": [{ "title": "Cheese", "width": 1440, "height": 900, "minWidth": 850, "minHeight": 650 }], "security": { "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; font-src 'self'; connect-src 'self'" } },
  "bundle": { "active": false }
}
